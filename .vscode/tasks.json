{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build: Adventure Editor",
            "type": "shell",
            "command": "mvn package -pl adventure-editor -am -DskipTests",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": "build",
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": "$maven"
        },
        {
            "label": "Build: Forge Mobile",
            "type": "shell",
            "command": "mvn package -pl forge-gui-mobile-dev -am -DskipTests",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": "build",
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": "$maven"
        },
        {
            "label": "Build: Forge Game",
            "type": "shell",
            "command": "mvn package -pl forge-gui-desktop -am -DskipTests",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": "build",
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": "$maven"
        },
        {
            "label": "Build: All (skip tests)",
            "type": "shell",
            "command": "mvn package -DskipTests",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": "$maven"
        },
        {
            "label": "Compile: Adventure Editor",
            "type": "shell",
            "command": "mvn compile -pl adventure-editor -am",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": "build",
            "presentation": {
                "reveal": "silent",
                "panel": "shared"
            },
            "problemMatcher": "$maven"
        },
        {
            "label": "Compile: Forge Game",
            "type": "shell",
            "command": "mvn compile -pl forge-gui-desktop -am",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": "build",
            "presentation": {
                "reveal": "silent",
                "panel": "shared"
            },
            "problemMatcher": "$maven"
        }
    ]
}
